# Copy to .env and edit. Every setting in examguard/config.py can be set here
# as EXAMGUARD_<NAME_IN_UPPERCASE>.

# Dashboard sign-in password (if empty, a random one is generated and printed at startup)
EXAMGUARD_PASSWORD=

# Camera: 0 = laptop webcam, or a phone-camera stream such as DroidCam:
# EXAMGUARD_SOURCE=http://192.168.1.50:4747/video
EXAMGUARD_SOURCE=0
EXAMGUARD_ROOM_NAME=Exam Room 1

# Optional student roster: names + photos, used to SUGGEST who a flagged face is (teacher verifies)
# EXAMGUARD_ROSTER_FILE=roster/roster.xlsx
# EXAMGUARD_ROSTER_PHOTOS_DIR=roster/photos

# Optional Gmail alerts. Needs 2-Step Verification on the Gmail account, then
# create an App password at https://myaccount.google.com/apppasswords
# EXAMGUARD_EMAIL_USER=yourname@gmail.com
# EXAMGUARD_EMAIL_APP_PASSWORD=abcdefghijklmnop
# EXAMGUARD_EMAIL_TO=teacher1@school.edu,teacher2@school.edu
# Address teachers open to review (used as the link in the email)
# EXAMGUARD_PUBLIC_URL=http://192.168.1.20:5000

# Optional: keep the evidence-encryption key outside the data folder
# (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
# EXAMGUARD_VAULT_KEY=

# Big rooms: how faces are found. auto = switch to the stronger detector if faces stay small; mediapipe; staged
# EXAMGUARD_FACE_DETECTOR=auto
# EXAMGUARD_DETECTOR_TILES=2

# --- Phase 2 -------------------------------------------------------------
# Performance profile: laptop (default, tested) | edge (Raspberry Pi class) | jetson | gpu.
# edge, jetson and gpu are NOT tested on real hardware: they are starting points to try. Anything you set
# below still wins over the profile. You can also pick one on the dashboard's "System check" page.
# EXAMGUARD_PROFILE=laptop
# Where the phone detector (YOLO) runs: auto | cpu | cuda   (cuda needs an NVIDIA GPU and a CUDA build of PyTorch)
# EXAMGUARD_DEVICE=auto

# Most faces read by ONE camera. Beyond about 100 students, add a second camera in the other corner:
# EXAMGUARD_MAX_STUDENTS=100
# EXAMGUARD_SECOND_SOURCE=http://192.168.1.51:4747/video
# EXAMGUARD_FIRST_CAMERA_NAME=Front camera
# EXAMGUARD_SECOND_CAMERA_NAME=Back camera

# Seat map: how close (in face widths) a face must be to a seat mark to count as sitting there
# EXAMGUARD_SEAT_RADIUS_FACES=1.6

# start.py restarts ExamGuard if the camera claims to be connected but sends no pictures for this long
# EXAMGUARD_WATCHDOG_SECONDS=90

# Learning from teacher decisions: names (comma-separated) allowed to approve or reject suggested threshold changes.
# Empty = any signed-in teacher. Names are typed at sign-in, so this is a safeguard, not strong security.
# EXAMGUARD_ADMIN_NAMES=Head Teacher, Ms Admin

# ---- Edge box + server (optional; default is everything on one computer) -------------------------------------
# EXAMGUARD_ROLE=edge            # on the box in the room (camera + AI).  EXAMGUARD_ROLE=server on the teachers' computer.
# EXAMGUARD_MQTT_HOST=192.168.1.10   # the MQTT broker (Mosquitto): see deploy/mosquitto.conf
# EXAMGUARD_MQTT_PORT=1883
# EXAMGUARD_MQTT_USER=edge       # "edge" on the box, "server" on the server (as created with mosquitto_passwd)
# EXAMGUARD_MQTT_PASSWORD=
# EXAMGUARD_MQTT_TLS=false
# EXAMGUARD_MQTT_KEY=            # REQUIRED for both: create with  python scripts/make_key.py  and use the SAME value on both
# EXAMGUARD_NODE_NAME=pi-room-1  # a name for the edge box
# EXAMGUARD_OUTBOX_MAX_MB=1024   # edge: how many MB of undelivered alerts to keep while the server is unreachable
